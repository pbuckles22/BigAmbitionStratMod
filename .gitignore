# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Common build / output (uncomment or extend for your stack)
dist/
build/
out/
coverage/
*.tsbuildinfo
.cache/

# Dependencies (uncomment what applies)
# node_modules/
# target/
# .venv/
# vendor/

# Full-repo Gemini XML dump (script/Export-GeminiSnapshot.ps1)
Gemini_Snapshot.txt
Gemini_Snapshot_*.txt

# Transient Gemini drop (keep README and empty dropzone marker)
doc/gemini/*
!doc/gemini/README.md
!doc/gemini/dropzone/
doc/gemini/dropzone/*
!doc/gemini/dropzone/.gitkeep

# Local compile counter. Never commit.
build_number.txt

# .NET
bin/
obj/
TestResults/

# Local handoff notes (keep template _template.md and README in repo)
.cursor/handoff/handoff-*.md
.cursor/handoff/*-handoff-*.md

# Optional second location for session handoff narratives (see AGENT_HANDOFF.md).
# If you track a contributor doc under doc/handoff/, use git exclude or ! to allow it.
doc/handoff/HANDOFF-*.md
doc/handoff/*-HANDOFF-*.md
