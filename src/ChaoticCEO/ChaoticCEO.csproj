<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChaoticCEO</RootNamespace>
    <AssemblyName>ChaoticCEO</AssemblyName>
    <Version>1.17.11.12</Version>
    <AssemblyVersion>1.17.11.12</AssemblyVersion>
    <FileVersion>1.17.11.12</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Big Ambitions\Big Ambitions_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BigAmbitions.ModAPI">
