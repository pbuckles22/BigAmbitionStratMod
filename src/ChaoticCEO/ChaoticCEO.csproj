<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChaoticCEO</RootNamespace>
    <AssemblyName>ChaoticCEO</AssemblyName>
    <Version>1.6.1.2</Version>
    <AssemblyVersion>1.6.1.2</AssemblyVersion>
    <FileVersion>1.6.1.2</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameManaged Condition="'$(GameManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Big Ambitions\Big Ambitions_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BigAmbitions.ModAPI">
      <HintPath>$(GameManaged)\BigAmbitions.ModAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BigAmbitions">
      <HintPath>$(GameManaged)\BigAmbitions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BigAmbitions.Items">
      <HintPath>$(GameManaged)\BigAmbitions.Items.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManaged)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireGameManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(GameManaged)\BigAmbitions.ModAPI.dll')"
      Text="GameManaged must point at Big Ambitions_Data\Managed. Missing BigAmbitions.ModAPI.dll." />
  </Target>

  <Target Name="StampCompile" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_NumberFile>$(MSBuildThisFileDirectory)..\..\build_number.txt</_NumberFile>
      <_NumberSeed>$(MSBuildThisFileDirectory)..\..\build_number.txt.example</_NumberSeed>
      <_DllTime Condition="Exists('$(TargetPath)')">$([System.IO.File]::GetLastWriteTime('$(TargetPath)').Ticks)</_DllTime>
      <_DllTime Condition="!Exists('$(TargetPath)')">0</_DllTime>
      <_NeedsBump Condition="!Exists('$(TargetPath)')">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)LoadLog.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)ChaoticCeoMod.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)StatementDump.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)LiveDump.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)RouteDump.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)DayRoll.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Advisor.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Overlay.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Advice.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Prices.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Plans.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Staffing.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Layout.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Close.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Buy.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)GameApi.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)CloseScore.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Logistics.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Payback.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Roadmap.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)Panel.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)PanelView.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)StoreFamily.cs').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
      <_NeedsBump Condition="Exists('$(TargetPath)') and $([System.IO.File]::GetLastWriteTime('$(MSBuildProjectFullPath)').Ticks) &gt; $(_DllTime)">true</_NeedsBump>
    </PropertyGroup>
    <Copy SourceFiles="$(_NumberSeed)" DestinationFiles="$(_NumberFile)" Condition="!Exists('$(_NumberFile)')" />
    <ReadLinesFromFile File="$(_NumberFile)">
      <Output TaskParameter="Lines" PropertyName="_PriorNumber" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PriorNumber Condition="'$(_PriorNumber)' == ''">0</_PriorNumber>
      <_NextNumber Condition="'$(_NeedsBump)' == 'true'">$([MSBuild]::Add($(_PriorNumber), 1))</_NextNumber>
      <_NextNumber Condition="'$(_NeedsBump)' != 'true'">$(_PriorNumber)</_NextNumber>
      <InformationalVersion>$(Version)+$(_NextNumber)</InformationalVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(_NumberFile)" Lines="$(_NextNumber)" Overwrite="true" Condition="'$(_NeedsBump)' == 'true'" />
  </Target>

  <Target Name="InstallToModsLocal" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LocalAppData>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))</_LocalAppData>
      <_DefaultModsLocal>$(_LocalAppData.Replace('\Local', '\LocalLow'))\Hovgaard Games\Big Ambitions\ModsLocal</_DefaultModsLocal>
      <_ModsLocal Condition="'$(ModsLocal)' == ''">$(_DefaultModsLocal)</_ModsLocal>
      <_ModsLocal Condition="'$(ModsLocal)' != ''">$(ModsLocal)</_ModsLocal>
      <_InstallDir>$(_ModsLocal)\ChaoticCEO</_InstallDir>
    </PropertyGroup>
    <MakeDir Directories="$(_InstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_InstallDir)\ChaoticCEO.dll" />
    <Message Importance="high" Text="mod.installed $(_InstallDir)\ChaoticCEO.dll" />
  </Target>

</Project>
